{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.linhanthon.game/schema/liveops.schema.json",
  "title": "Linh An Thon - Chapter 1 - LiveOps & Monetization Config Schema",
  "description": "Hop dong du lieu cho data/liveops_chapter_01.json. Sau khoa Master Form bat buoc, khong duoc doi ten: hint_cost_gems, ads_reward_hints, iap_product_id, price_usd, event_start, override_bg. Cac bat bien lien truong (thu tu tang dan cua tier, tong allocation_pct = 100, event_start < event_end, hai su kien khong chong cua so tren cung mot area...) do tools/validate_level.py --liveops kiem, xem danh sach trong khoa 'validation.invariants' cua chinh file cau hinh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "config_version",
    "chapter_id",
    "rollout",
    "hint_system",
    "iap",
    "seasonal_events",
    "gem_economy",
    "ad_placements",
    "telemetry",
    "remote_config_keys",
    "ab_tests",
    "player_safety_compliance",
    "validation"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "config_id": { "type": "string", "pattern": "^liveops_chapter_[0-9]{2}$" },
    "config_version": { "$ref": "#/$defs/semver" },
    "chapter_id": { "type": "string", "pattern": "^chapter_[0-9]{2}$" },
    "project": { "type": "string", "maxLength": 120 },
    "language": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "last_updated_utc": { "$ref": "#/$defs/utc_timestamp" },
    "owner": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "remote_config_namespace": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "server_time_source": { "type": "string", "enum": ["NTP_UTC", "SERVER_HEADER", "DEVICE_LOCAL"] },

    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "percent", "min_app_version", "kill_switches"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["DRAFT", "STAGING", "CANARY", "LIVE", "PAUSED", "ROLLED_BACK"]
        },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "min_app_version": { "$ref": "#/$defs/semver" },
        "min_addressables_catalog_version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$",
          "description": "Phien ban catalog Addressables toi thieu. May co catalog cu hon phai tai catalog moi truoc khi ap cau hinh nay."
        },
        "kill_switches": {
          "type": "object",
          "additionalProperties": { "type": "boolean" },
          "required": [
            "kill_switch_ads",
            "kill_switch_iap",
            "kill_switch_event_theme",
            "kill_switch_paid_hints",
            "kill_switch_telemetry"
          ],
          "description": "Cong tat khan cap. true = tat tinh nang tuong ung ngay o lan fetch remote config ke tiep, khong can build lai app."
        }
      }
    },

    "hint_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hint_cost_gems",
        "ads_reward_hints",
        "free_path_guaranteed",
        "max_wait_sec_to_full_solution",
        "tiers",
        "unlock_sources",
        "constraints"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "hint_cost_gems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "description": "KHOA MASTER FORM. Don gia co so cua mot don vi goi y, tinh bang gem."
        },
        "ads_reward_hints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "KHOA MASTER FORM. So don vi goi y doi duoc tu mot luot xem quang cao thuong."
        },
        "free_path_guaranteed": {
          "const": true,
          "description": "Nguyen tac N1 - khong duoc phep dat false. Moi tier phai co duong mo mien phi bang thoi gian cho."
        },
        "max_wait_sec_to_full_solution": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "description": "Tran thoi gian cho de mo duoc dap an day du mien phi."
        },
        "hint_button": {
          "type": "object",
          "additionalProperties": false,
          "required": ["button_id", "bounds"],
          "properties": {
            "button_id": { "type": "string", "pattern": "^btn_[a-z0-9_]+$" },
            "ten_vi": { "type": "string", "maxLength": 120 },
            "bounds": { "$ref": "#/$defs/bounds" },
            "visible_when": { "type": "string", "enum": ["ALWAYS", "PUZZLE_OPEN", "AFTER_FIRST_FAIL"] },
            "blocked_during": { "type": "array", "items": { "$ref": "#/$defs/ui_state" }, "uniqueItems": true }
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "tier_id", "content_type", "unlock_free_after_sec", "gem_cost", "ads_required"],
            "properties": {
              "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
              "tier_id": { "type": "string", "pattern": "^hint_tier_[0-9]_[a-z0-9_]+$" },
              "ten_vi": { "type": "string", "maxLength": 120 },
              "content_type": { "type": "string", "enum": ["NUDGE", "METHOD", "SOLUTION"] },
              "mo_ta_vi": { "type": "string", "maxLength": 500 },
              "unlock_free_after_sec": { "type": "integer", "minimum": 0, "maximum": 900 },
              "unlock_free_after_fails": { "type": "integer", "minimum": 0, "maximum": 50 },
              "gem_cost": { "type": "integer", "minimum": 0, "maximum": 999 },
              "gem_cost_multiplier": { "type": "number", "minimum": 0 },
              "ads_required": { "type": "integer", "minimum": 0, "maximum": 10 },
              "requires_confirm": { "type": "boolean" },
              "text_key_pattern": { "type": "string", "pattern": "^txt_[a-z0-9_{}]+$" }
            }
          }
        },
        "unlock_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["source", "gem_cost", "ads_required"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["FREE_WAIT", "FREE_FAIL_COUNT", "MERCY_GRANT", "REWARDED_AD", "GEM_SPEND"]
              },
              "gem_cost": { "type": "integer", "minimum": 0 },
              "ads_required": { "type": "integer", "minimum": 0 },
              "always_available": { "type": "boolean" }
            }
          },
          "description": "Phai co it nhat mot nguon voi gem_cost = 0 VA ads_required = 0 (duong mien phi) - validator kiem."
        },
        "price_escalation": { "type": "object", "additionalProperties": true },
        "daily_limits": { "type": "object", "additionalProperties": true },
        "mercy_hint": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "never_shows_ad": { "const": true },
            "never_shows_paywall": { "const": true },
            "stuck_threshold_sec": { "type": "integer", "minimum": 1 }
          },
          "description": "Goi y thuong hai chong rage-quit. Nguyen tac N3: tuyet doi khong gan quang cao hay paywall vao khoanh khac nguoi choi be tac."
        },
        "per_puzzle_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["puzzle_id", "area_id"],
            "properties": {
              "puzzle_id": { "type": "string", "pattern": "^puz_[a-z0-9_]+$" },
              "area_id": { "type": "string", "pattern": "^area_[a-z0-9_]+$" },
              "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
              "target_solve_sec": { "type": "integer", "minimum": 1 },
              "tier1_unlock_free_after_sec": { "type": "integer", "minimum": 0 },
              "tier2_unlock_free_after_sec": { "type": "integer", "minimum": 0 },
              "tier3_unlock_free_after_sec": { "type": "integer", "minimum": 0 },
              "tier2_gem_cost": { "type": "integer", "minimum": 0 },
              "tier3_gem_cost": { "type": "integer", "minimum": 0 },
              "mercy_fail_threshold": { "type": "integer", "minimum": 1 }
            }
          },
          "description": "Ghi de theo tung cau do. puzzle_id / area_id phai ton tai trong data/areas/ - validator kiem tham chieu cheo."
        },
        "constraints": {
          "type": "object",
          "additionalProperties": { "type": "boolean" },
          "required": [
            "hint_never_blocks_progress",
            "hint_never_consumes_items",
            "accessibility_never_gated",
            "no_ad_inside_puzzle_fail_moment",
            "max_fails_never_overridden"
          ],
          "properties": {
            "hint_never_blocks_progress": { "const": true },
            "hint_never_consumes_items": { "const": true },
            "accessibility_never_gated": { "const": true },
            "no_ad_inside_puzzle_fail_moment": { "const": true },
            "max_fails_never_overridden": {
              "const": true,
              "description": "LiveOps khong duoc ghi de jumpscares[].max_fails trong file area - nhip kinh di thuoc quyen 04_horror, khong thuoc quyen kiem tien."
            }
          }
        }
      }
    },

    "iap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "products", "restore", "fair_play", "paywall"],
      "properties": {
        "enabled": { "type": "boolean" },
        "store_price_source": { "type": "string", "enum": ["STORE_LOCALIZED_PRICE", "CONFIG_FIXED_PRICE"] },
        "price_display_rule": { "type": "string", "maxLength": 500 },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/iap_product" }
        },
        "restore": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "verify_receipt_server_side"],
          "properties": {
            "enabled": { "const": true },
            "verify_receipt_server_side": {
              "const": true,
              "description": "Bat buoc xac thuc bien lai phia may chu - khong tin ket qua tra ve tu client."
            },
            "offline_grace_hours": { "type": "integer", "minimum": 0, "maximum": 720 }
          }
        },
        "fair_play": {
          "type": "object",
          "additionalProperties": true,
          "required": ["no_pay_to_win", "sellable_categories", "free_completion_guaranteed"],
          "properties": {
            "no_pay_to_win": { "const": true },
            "free_completion_guaranteed": { "const": true },
            "sellable_categories": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["CONTENT_UNLOCK", "CONVENIENCE_HINT", "COSMETIC"] },
              "description": "Nguyen tac N2 - dong tap dong. Chi ban NOI DUNG, TIEN ICH, TRANG TRI."
            },
            "forbidden_categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "paywall": {
          "type": "object",
          "additionalProperties": true,
          "required": ["placement_id", "dismissible", "never_show_during", "must_show_price_before_confirm"],
          "properties": {
            "placement_id": { "type": "string", "pattern": "^paywall_[a-z0-9_]+$" },
            "trigger_flag": { "type": "string", "pattern": "^flag_[a-z0-9_]+$" },
            "show_after_sec_from_credits": { "type": "integer", "minimum": 0 },
            "dismissible": { "const": true },
            "max_impressions_per_day": { "type": "integer", "minimum": 0, "maximum": 10 },
            "never_show_during": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/ui_state" },
              "allOf": [
                { "contains": { "const": "JUMPSCARE_ENVELOPE" } },
                { "contains": { "const": "PUZZLE" } },
                { "contains": { "const": "CUTSCENE" } }
              ],
              "description": "Nguyen tac N3 - khong moi mua hang o dinh so."
            },
            "must_show_price_before_confirm": { "const": true },
            "must_show_contents_list": { "const": true },
            "text_key": { "type": "string", "pattern": "^txt_[a-z0-9_]+$" }
          }
        }
      }
    },

    "seasonal_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/seasonal_event" }
    },

    "gem_economy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["currency_id", "max_balance", "starting_balance", "sources", "sinks", "balance_targets", "forbidden"],
      "properties": {
        "currency_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "ten_vi": { "type": "string", "maxLength": 120 },
        "icon_asset": { "type": "string", "pattern": "^[a-z0-9_]+\\.(png|bundle)$" },
        "max_balance": { "type": "integer", "minimum": 1 },
        "server_authoritative": { "type": "boolean" },
        "starting_balance": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["source_id", "amount", "type"],
            "properties": {
              "source_id": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
              "amount": { "type": "integer", "minimum": 0 },
              "cap": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "type": { "type": "string", "enum": ["FREE", "AD", "IAP"] }
            }
          }
        },
        "sinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["sink_id", "amount", "category"],
            "properties": {
              "sink_id": { "type": "string", "pattern": "^snk_[a-z0-9_]+$" },
              "amount": { "type": "integer", "minimum": 0 },
              "category": { "type": "string", "enum": ["CONVENIENCE", "COSMETIC", "BONUS_CONTENT"] }
            }
          }
        },
        "balance_targets": {
          "type": "object",
          "additionalProperties": true,
          "required": ["expected_free_earn_chapter_01", "expected_spend_p90_player", "free_player_can_finish_without_gems"],
          "properties": {
            "expected_free_earn_chapter_01": { "type": "integer", "minimum": 0 },
            "expected_spend_median_player": { "type": "integer", "minimum": 0 },
            "expected_spend_p90_player": { "type": "integer", "minimum": 0 },
            "free_player_can_finish_without_gems": { "const": true }
          }
        },
        "forbidden": {
          "type": "object",
          "additionalProperties": true,
          "required": ["gem_cannot_buy", "no_negative_balance"],
          "properties": {
            "gem_cannot_buy": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "SAFETY_OPTIONS" } },
                { "contains": { "const": "ACCESSIBILITY_OPTIONS" } },
                { "contains": { "const": "RANDOM_BOXES" } }
              ]
            },
            "no_negative_balance": { "const": true }
          }
        }
      }
    },

    "ad_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["placement_id", "ad_format", "opt_in_only", "reward", "max_per_day", "blocked_windows"],
        "properties": {
          "placement_id": { "type": "string", "pattern": "^ad_[a-z0-9_]+$" },
          "ad_format": {
            "type": "string",
            "enum": ["REWARDED_VIDEO", "REWARDED_INTERSTITIAL"],
            "description": "Nguyen tac N3: CHI quang cao thuong co chu dich. Cam INTERSTITIAL va BANNER trong Chuong 1."
          },
          "opt_in_only": { "const": true },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "amount"],
            "properties": {
              "type": { "type": "string", "enum": ["HINT_CREDIT", "GEM"] },
              "amount": { "type": "integer", "minimum": 1 }
            }
          },
          "max_per_day": { "type": "integer", "minimum": 0, "maximum": 50 },
          "min_gap_sec": { "type": "integer", "minimum": 0 },
          "entry_points": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "blocked_windows": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "allOf": [
              { "contains": { "const": "DURING_JUMPSCARE_ENVELOPE" } },
              { "contains": { "const": "WITHIN_90S_AFTER_ANY_JUMPSCARE" } },
              { "contains": { "const": "DURING_CUTSCENE" } },
              { "contains": { "const": "DURING_PUZZLE_INPUT" } }
            ],
            "description": "Bat bien an toan - bon cua so nay bat buoc phai co mat."
          },
          "audio_rule": { "type": "string", "maxLength": 500 }
        }
      }
    },

    "telemetry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "events"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sampling_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "common_params": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["event_name", "params"],
            "properties": {
              "event_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 40
              },
              "muc_dich_vi": { "type": "string", "maxLength": 300 },
              "params": {
                "type": "array",
                "maxItems": 25,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              }
            }
          }
        }
      }
    },

    "remote_config_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "type", "default"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
          "type": { "type": "string", "enum": ["string", "int", "float", "bool", "json"] },
          "requires_restart": { "type": "boolean" },
          "owner": { "type": "string" }
        }
      }
    },

    "ab_tests": {
      "type": "object",
      "additionalProperties": true,
      "required": ["assignment", "slots"],
      "properties": {
        "assignment": {
          "type": "object",
          "additionalProperties": true,
          "required": ["unit", "sticky"],
          "properties": {
            "unit": { "type": "string", "enum": ["install_id", "account_id", "device_id"] },
            "hash_salt": { "type": "string", "minLength": 4 },
            "sticky": { "const": true },
            "holdout_pct": { "type": "integer", "minimum": 0, "maximum": 50 }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["slot_id", "primary_metric", "variants"],
            "properties": {
              "slot_id": { "type": "string", "pattern": "^ab_slot_[a-z0-9_]+$" },
              "primary_metric": { "type": "string" },
              "min_sample_per_variant": { "type": "integer", "minimum": 1 },
              "min_duration_days": { "type": "integer", "minimum": 1 },
              "variants": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["variant_id", "allocation_pct", "overrides"],
                  "properties": {
                    "variant_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "allocation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                    "overrides": {
                      "type": "object",
                      "additionalProperties": true,
                      "description": "Moi khoa o day phai ton tai trong remote_config_keys[].key - validator kiem."
                    }
                  }
                },
                "description": "Tong allocation_pct cua moi slot phai bang 100 - validator kiem."
              }
            }
          }
        }
      }
    },

    "player_safety_compliance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["no_loot_box", "price_transparency", "age_rating", "accessibility_never_monetized", "data_privacy", "spending_protection"],
      "properties": {
        "no_loot_box": {
          "type": "object",
          "additionalProperties": true,
          "required": ["randomized_paid_rewards"],
          "properties": {
            "randomized_paid_rewards": {
              "const": false,
              "description": "Khong hop qua ngau nhien, khong gacha, khong quay so. Bat bien phap ly + nguyen tac N5."
            },
            "randomized_product_ids": { "type": "array", "maxItems": 0 }
          }
        },
        "price_transparency": {
          "type": "object",
          "additionalProperties": true,
          "required": ["show_localized_price_before_confirm", "two_step_confirm"],
          "properties": {
            "show_localized_price_before_confirm": { "const": true },
            "show_contents_list_before_confirm": { "const": true },
            "two_step_confirm": { "const": true },
            "no_pre_checked_purchase_option": { "const": true },
            "no_dark_pattern_countdown": { "const": true }
          }
        },
        "age_rating": { "type": "object", "additionalProperties": true },
        "ads_placement_safety": { "type": "object", "additionalProperties": true },
        "accessibility_never_monetized": {
          "type": "object",
          "additionalProperties": { "const": true },
          "minProperties": 1,
          "description": "Nguyen tac N4 - MOI gia tri trong khoi nay bat buoc bang true. Khong tuy chon an toan nao nam sau tuong tra phi, quang cao hay moc tien trinh."
        },
        "data_privacy": { "type": "object", "additionalProperties": true },
        "spending_protection": { "type": "object", "additionalProperties": true }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariants"],
      "properties": {
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "maxLength": 300 },
          "description": "Danh sach bat bien bang tieng Viet, doc duoc cho nguoi. tools/validate_level.py hien thuc tung dong o day - khi them mot dong moi, phai them mot ham kiem tuong ung."
        },
        "schema_file": { "type": "string" },
        "validator_tool": { "type": "string" }
      }
    }
  },

  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1919 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1079 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1080 }
      }
    },
    "ui_state": {
      "type": "string",
      "enum": [
        "CUTSCENE",
        "PUZZLE",
        "PUZZLE_INPUT",
        "JUMPSCARE_ENVELOPE",
        "SAFETY_WARNING_SCREEN",
        "AREA_TRANSITION",
        "ENDING_CUTSCENE",
        "LOADING_SCREEN"
      ]
    },

    "iap_product": {
      "type": "object",
      "additionalProperties": true,
      "required": ["iap_product_id", "product_type", "price_usd", "regional_pricing"],
      "properties": {
        "iap_product_id": {
          "type": "string",
          "pattern": "^com\\.game\\.[a-z0-9_.]+$",
          "description": "KHOA MASTER FORM. Ma san pham dang ky tren App Store / Google Play."
        },
        "product_type": {
          "type": "string",
          "enum": ["NON_CONSUMABLE", "CONSUMABLE"],
          "description": "Chuong 1 khong ban thue bao - SUBSCRIPTION bi cam."
        },
        "ten_vi": { "type": "string", "maxLength": 120 },
        "mo_ta_vi": { "type": "string", "maxLength": 500 },
        "price_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 99.99,
          "description": "KHOA MASTER FORM. Gia neo bang USD. Gia hien thi that luon lay tu store."
        },
        "store_price_tier": { "type": "object", "additionalProperties": true },
        "unlock": { "type": "object", "additionalProperties": true },
        "requires": { "type": "object", "additionalProperties": true },
        "regional_pricing": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["region_code", "currency", "price_local"],
            "properties": {
              "region_code": { "type": "string", "pattern": "^[A-Z_]{2,16}$" },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "price_local": { "type": "number", "exclusiveMinimum": 0 },
              "price_usd_equiv": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "description": "Bat buoc co du ba vung neo VN, US, SEA_DEFAULT - validator kiem."
        }
      }
    },

    "seasonal_event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event_id", "enabled", "event_start", "event_end", "override_bg", "applies_to_areas", "addressables", "fallback"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^evt_[a-z0-9_]+$" },
        "ten_vi": { "type": "string", "maxLength": 120 },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0 },
        "event_start": {
          "$ref": "#/$defs/iso_date",
          "description": "KHOA MASTER FORM. Ngay mo su kien (YYYY-MM-DD)."
        },
        "event_end": { "$ref": "#/$defs/iso_date" },
        "timezone": { "type": "string", "pattern": "^[A-Za-z]+/[A-Za-z_]+$" },
        "server_authoritative_time": {
          "const": true,
          "description": "Khong tin dong ho may - nguoi choi van gio may se mo duoc su kien."
        },
        "grace_period_hours": { "type": "integer", "minimum": 0, "maximum": 168 },
        "override_bg": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.bundle$",
          "description": "KHOA MASTER FORM. Bundle anh nen thay the trong thoi gian su kien. Phai nam trong addressables.bundles - validator kiem."
        },
        "applies_to_areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^area_[a-z0-9_]+$" },
          "description": "Cac area_id phai ton tai trong chapter manifest - validator kiem."
        },
        "theme_override": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "does_not_change": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "hotspot_bounds" } },
                { "contains": { "const": "puzzle_solution" } },
                { "contains": { "const": "jumpscare_trigger_type" } },
                { "contains": { "const": "max_fails" } }
              ],
              "description": "Su kien theo mua CHI duoc doi lop trang tri. Bon muc nay la phan cot loi cua man choi, tuyet doi khong duoc ghi de."
            }
          }
        },
        "addressables": {
          "type": "object",
          "additionalProperties": true,
          "required": ["bundles", "download_policy"],
          "properties": {
            "bundles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.bundle$" }, "uniqueItems": true },
            "extra_bundle_labels": { "type": "array", "items": { "type": "string" } },
            "estimated_download_mb": { "type": "number", "minimum": 0, "maximum": 200 },
            "download_policy": { "type": "string", "enum": ["ON_EVENT_ENTER", "PREFETCH_ON_WIFI", "ON_DEMAND"] },
            "wifi_only_default": { "type": "boolean" },
            "prefetch_days_before_start": { "type": "integer", "minimum": 0, "maximum": 30 }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": true,
          "required": ["on_download_fail", "never_block_gameplay"],
          "properties": {
            "on_download_fail": { "type": "string", "enum": ["USE_BASE_BACKGROUND", "RETRY_SILENT", "SKIP_EVENT"] },
            "timeout_sec": { "type": "integer", "minimum": 1, "maximum": 120 },
            "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
            "retry_backoff_sec": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "never_block_gameplay": {
              "const": true,
              "description": "Tai giao dien su kien that bai KHONG BAO GIO duoc chan nguoi choi - luon lui ve nen goc."
            },
            "never_show_error_modal": { "type": "boolean" },
            "toast_text_key": { "type": "string", "pattern": "^txt_[a-z0-9_]+$" }
          }
        },
        "rewards": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "no_exclusive_gameplay_content": {
              "const": true,
              "description": "Su kien khong duoc chua manh moi hay noi dung choi doc quyen - bo lo su kien khong lam mat noi dung."
            }
          }
        }
      }
    }
  }
}
